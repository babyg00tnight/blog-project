@using Microsoft.AspNetCore.Identity
@using MyBlogCMS.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - VLP Blog</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    @RenderSection("Scripts", required: false)

    <style>
        body {
            background-color: #121212;
            color: #f8f9fa;
            font-family: 'Segoe UI', sans-serif;
        }

        a, .nav-link {
            text-decoration: none !important;
            transition: color 0.2s ease;
        }

            .nav-link:hover {
                color: #0dcaf0 !important;
            }

        .navbar {
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        footer {
            color: #aaa;
            font-size: 0.9rem;
        }

            footer a {
                color: #0dcaf0;
                text-decoration: none;
            }

                footer a:hover {
                    text-decoration: underline;
                }
    </style>
</head>

<body>
    <!-- 🔹 NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-black">
        <div class="container">
            <a class="navbar-brand fw-bold text-light" asp-area="" asp-controller="Home" asp-action="Index">
                🔭 VLP Blog
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link text-light" asp-controller="Home" asp-action="Index">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light" asp-controller="Posts" asp-action="Index">Bài viết</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light" asp-controller="Categories" asp-action="Index">Chuyên mục</a>
                    </li>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item me-3">
                            <span class="navbar-text text-light">
                                👋 Xin chào, <strong>@UserManager.GetUserName(User)</strong>
                            </span>
                        </li>
                        <li class="nav-item">
                            <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    Đăng xuất
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="Identity" asp-page="/Account/Register">Đăng ký</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- 🔹 MAIN CONTENT -->
    <main class="container my-5">
        @RenderBody()
    </main>

    <!-- 🔹 FOOTER -->
    <footer class="bg-black py-3 mt-auto">
        <div class="container text-center">
            <p class="mb-1">© @DateTime.Now.Year VLP Blog — Chia sẻ tri thức và trải nghiệm</p>
            <p class="mb-0">
                <a href="#">Liên hệ</a> •
                <a href="#">Điều khoản</a> •
                <a href="#">Chính sách bảo mật</a>
            </p>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
