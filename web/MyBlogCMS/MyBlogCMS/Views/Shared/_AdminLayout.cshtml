@using Microsoft.AspNetCore.Identity
@using MyBlogCMS.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Trang quản trị</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body {
            background-color: #181818;
            color: #f8f9fa;
            font-family: 'Segoe UI', sans-serif;
        }

        .sidebar {
            height: 100vh;
            width: 250px;
            position: fixed;
            left: 0;
            top: 0;
            background-color: #202020;
            border-right: 1px solid rgba(255,255,255,0.1);
            padding-top: 20px;
        }

            .sidebar .nav-link {
                color: #ccc;
                padding: 12px 20px;
                display: flex;
                align-items: center;
                gap: 10px;
                transition: all 0.2s ease;
            }

                .sidebar .nav-link:hover,
                .sidebar .nav-link.active {
                    background-color: #2c2c2c;
                    color: #0dcaf0;
                }

            .sidebar .navbar-brand {
                font-size: 1.4rem;
                font-weight: bold;
                color: #fff;
                text-align: center;
                display: block;
                margin-bottom: 30px;
            }

        .content {
            margin-left: 250px;
            padding: 30px;
        }

        .topbar {
            background-color: #111;
            padding: 10px 20px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .dropdown-menu-dark {
            background-color: #2c2c2c;
        }
    </style>
</head>

<body>
    <!-- 🔹 SIDEBAR -->
    <div class="sidebar d-flex flex-column">
        <a class="navbar-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
            ⚙️ Admin Panel
        </a>
        <nav class="nav flex-column">
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
               asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-house"></i> Bảng điều khiển
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Posts" ? "active" : "")"
               asp-area="Admin" asp-controller="Posts" asp-action="Index">
                <i class="bi bi-file-earmark-text"></i> Quản lý bài viết
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")"
               asp-area="Admin" asp-controller="Categories" asp-action="Index">
                <i class="bi bi-folder"></i> Chuyên mục
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")"
               asp-area="Admin" asp-controller="Users" asp-action="Index">
                <i class="bi bi-people"></i> Người dùng
            </a>
        </nav>
    </div>

    <!-- 🔹 MAIN CONTENT -->
    <div class="content">
        <div class="topbar d-flex justify-content-between align-items-center">
            <h5 class="m-0">@ViewData["Title"]</h5>

            <div class="dropdown">
                @if (SignInManager.IsSignedIn(User))
                {
                    <a class="text-light dropdown-toggle text-decoration-none" href="#" data-bs-toggle="dropdown">
                        👤 @UserManager.GetUserName(User)
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
                        <li>
                            <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="m-0">
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right"></i> Đăng xuất
                                </button>
                            </form>
                        </li>
                    </ul>
                }
            </div>
        </div>

        <div class="mt-4">
            @RenderBody()
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
