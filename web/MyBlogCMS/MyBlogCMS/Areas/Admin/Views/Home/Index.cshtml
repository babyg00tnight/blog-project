@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Bảng điều khiển";
    var stats = ViewBag.PostStats as IEnumerable<dynamic>;
}

<div class="container-fluid mt-4 text-white">
    <h2 class="mb-4">📊 Bảng điều khiển quản trị</h2>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white shadow">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h5>Tổng bài viết</h5>
                        <h2>@ViewBag.TotalPosts</h2>
                    </div>
                    <i class="bi bi-file-earmark-text display-4 opacity-75"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-success text-white shadow">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h5>Danh mục</h5>
                        <h2>@ViewBag.TotalCategories</h2>
                    </div>
                    <i class="bi bi-folder2-open display-4 opacity-75"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-warning text-dark shadow">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h5>Người dùng</h5>
                        <h2>@ViewBag.TotalUsers</h2>
                    </div>
                    <i class="bi bi-people display-4 opacity-75"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card bg-dark border-secondary shadow">
        <div class="card-header text-white">
            <h5>📈 Thống kê bài viết theo danh mục</h5>
        </div>
        <div class="card-body">
            <canvas id="postChart" height="100"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('postChart');
        const labels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(stats?.Select(s => s.CategoryName)));
        const data = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(stats?.Select(s => s.Count)));

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Số lượng bài viết',
                    data: data,
                    borderWidth: 1,
                    backgroundColor: 'rgba(54, 162, 235, 0.6)',
                    borderColor: 'rgba(54, 162, 235, 1)'
                }]
            },
            options: {
                scales: {
                    y: { beginAtZero: true, ticks: { color: '#fff' } },
                    x: { ticks: { color: '#fff' } }
                },
                plugins: {
                    legend: { labels: { color: '#fff' } }
                }
            }
        });
    </script>
}
