@model MyBlogCMS.Models.Post
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chỉnh sửa bài viết";
}

<div class="container-fluid text-light">
    <h2 class="fw-bold mb-4">✏️ Chỉnh sửa bài viết</h2>

    <form asp-action="Edit" enctype="multipart/form-data" class="card bg-dark p-4 shadow-lg border-0">
        <input type="hidden" asp-for="PostId" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label">Tiêu đề</label>
            <input asp-for="Title" class="form-control bg-secondary text-white border-0" />
        </div>

        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label">Danh mục</label>
            <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select bg-secondary text-white border-0"></select>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Mô tả</label>
            <textarea asp-for="Description" class="form-control bg-secondary text-white border-0" rows="2"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="Content" class="form-label">Nội dung</label>
            <textarea asp-for="Content" class="form-control bg-secondary text-white border-0" rows="6"></textarea>
        </div>

        <div class="mb-4">
            <label asp-for="ThumbnailFile" class="form-label">Ảnh bìa</label>
            <input asp-for="ThumbnailFile" type="file" class="form-control bg-secondary text-white border-0" />
            @if (!string.IsNullOrEmpty(Model.Thumbnail))
            {
                <div class="mt-2">
                    <img src="@Model.ThumbnailPath" width="150" class="rounded shadow" />
                </div>
            }
        </div>

        <div class="text-end">
            <a asp-action="Index" class="btn btn-outline-light me-2">Hủy</a>
            <button type="submit" class="btn btn-warning"><i class="bi bi-save"></i> Cập nhật</button>
        </div>
    </form>
</div>
