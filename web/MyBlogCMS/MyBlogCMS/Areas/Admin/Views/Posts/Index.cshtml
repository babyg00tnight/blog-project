@model IEnumerable<MyBlogCMS.Models.Post>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý bài viết";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-light">📰 Quản lý bài viết</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Thêm bài viết
        </a>
    </div>

    <div class="card bg-dark border-0 shadow-lg">
        <div class="card-body">
            <table class="table table-dark table-hover align-middle">
                <thead class="table-secondary text-dark">
                    <tr>
                        <th>Ảnh</th>
                        <th>Tiêu đề</th>
                        <th>Danh mục</th>
                        <th>Mô tả</th>
                        <th>Ngày tạo</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <img src="@item.ThumbnailPath" width="90" height="60" class="rounded border border-secondary object-fit-cover" />
                            </td>
                            <td class="fw-semibold">@item.Title</td>
                            <td>@item.Category?.Name</td>
                            <td>@item.Description</td>
                            <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.PostId" class="btn btn-warning btn-sm me-2">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.PostId" class="btn btn-danger btn-sm">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
